<span><span>    return</span><span> P1c, P1, P2, A, q2, o </span><span>//</span><span> 3</span><span>, (</span><span>1</span><span> if</span><span> (o </span><span>%</span><span> 3</span><span>) </span><span>&gt;=</span><span> Lf </span><span>else</span><span> 0</span><span>)   </span><span># d = o // 3, u = the split bit</span></span>
