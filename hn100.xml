<span>          </span><span>FROM</span><span>   </span><span>'footprints.parquet'</span><span>)</span>
<span>WHERE</span><span>    </span><span>column_type</span><span>::</span><span>TEXT</span><span> </span><span>NOT</span><span> </span><span>LIKE</span><span> </span><span>'STRUCT%'</span>
<span>AND</span><span>      </span><span>column_type</span><span>::</span><span>TEXT</span><span> </span><span>NOT</span><span> </span><span>LIKE</span><span> </span><span>'%[]%'</span>
<span>ORDER</span><span> </span><span>BY</span><span> </span><span>LOWER</span><span>(</span><span>column_name</span><span>);</span>
</pre></div>
