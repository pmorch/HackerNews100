    <div>
      
                  
      <p><a href="https://yale-threesixty.transforms.svdcdn.com/production/Bombed-Reef_Ocean-Agency.jpg?w=1200&amp;h=800&amp;auto=compress%2Cformat&amp;fit=crop&amp;dm=1787651638&amp;s=68d3e51f7fa2324611e7da4df43c09e1" data-caption="A bomb-fished coral reef in Sulawesi, Indonesia." data-credit="The Ocean Agency">
  
  
  
    
  
  
  
      
    
                
    
                
    
                
    
                
    
                        
  <img sizes="(min-width: 1450px) 832px, (min-width: 620px) 620px, 100vw" srcset="https://yale-threesixty.transforms.svdcdn.com/production/Bombed-Reef_Ocean-Agency.jpg?w=1200&amp;h=800&amp;auto=compress%2Cformat&amp;fit=crop&amp;dm=1787651638&amp;s=68d3e51f7fa2324611e7da4df43c09e1 1200w, https://yale-threesixty.transforms.svdcdn.com/production/Bombed-Reef_Ocean-Agency.jpg?w=200&amp;auto=compress%2Cformat&amp;fit=clip&amp;dm=1787651638&amp;s=e2648c212e93e8e58e0c3767f65e71fd 200w, https://yale-threesixty.transforms.svdcdn.com/production/Bombed-Reef_Ocean-Agency.jpg?w=400&amp;auto=compress%2Cformat&amp;fit=clip&amp;dm=1787651638&amp;s=0913115f4c72a4adcb739c4e6713c510 400w, https://yale-threesixty.transforms.svdcdn.com/production/Bombed-Reef_Ocean-Agency.jpg?w=600&amp;auto=compress%2Cformat&amp;fit=clip&amp;dm=1787651638&amp;s=5d5cf73b5532ab0cac1533066b8c0c37 600w, https://yale-threesixty.transforms.svdcdn.com/production/Bombed-Reef_Ocean-Agency.jpg?w=800&amp;auto=compress%2Cformat&amp;fit=clip&amp;dm=1787651638&amp;s=3a95585cca201c02760af5f0e4efa3b7 800w, https://yale-threesixty.transforms.svdcdn.com/production/Bombed-Reef_Ocean-Agency.jpg?w=1000&amp;auto=compress%2Cformat&amp;fit=clip&amp;dm=1787651638&amp;s=d073fe78a07e667e19c49c82d7012240 1000w" src="https://yale-threesixty.transforms.svdcdn.com/production/Bombed-Reef_Ocean-Agency.jpg?w=400&amp;auto=compress%2Cformat&amp;fit=clip&amp;dm=1787651638&amp;s=0913115f4c72a4adcb739c4e6713c510" alt="A bomb-fished coral reef in Sulawesi, Indonesia.">
</a>
      </p>
          </div>

        <figcaption>
              <p><span>A bomb-fished coral reef in Sulawesi, Indonesia.</span>
          <span>The Ocean Agency</span></p>
    </figcaption>
    
