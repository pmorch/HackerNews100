<span><span>    q3  </span><span>=</span><span> parity(a </span><span>&amp;</span><span> 0x</span><span>3C9041000</span><span>)</span></span>
<span><span>    carry </span><span>=</span><span> 1</span><span> if</span><span> q0 </span><span>+</span><span> q1 </span><span>+</span><span> q2 </span><span>&gt;=</span><span> 2</span><span> else</span><span> 0</span><span>        # q0,q1,q2 as a full adder: the carry (majority)...</span></span>
<span><span>    start </span><span>=</span><span> (</span><span>5</span><span> +</span><span> 7</span><span>*</span><span>q0 </span><span>+</span><span> 5</span><span>*</span><span>q1 </span><span>+</span><span> 2</span><span>*</span><span>q2 </span><span>+</span><span> q3 </span><span>-</span><span> carry) </span><span>%</span><span> 9</span><span>   # ...sets where the counter starts</span></span>
