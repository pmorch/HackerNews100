<span><span>    q0  </span><span>=</span><span> parity(a </span><span>&amp;</span><span> 0x</span><span>8000</span><span>)                     </span><span># four correction parities</span></span>
<span><span>    q1  </span><span>=</span><span> parity(a </span><span>&amp;</span><span> 0x</span><span>5985E0500</span><span>)</span></span>
