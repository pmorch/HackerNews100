<span>impl</span><span>&lt;</span><span>'</span><span>a</span><span>:</span> <span>'</span><span>static</span><span>&gt;</span> <span>Drop</span> <span>for</span> <span>Q</span><span>&lt;</span><span>'</span><span>a</span><span>&gt;</span> <span>{</span>
    <span>fn</span> <span>drop</span><span>(</span><span>&amp;</span><span>mut</span> <span>self</span><span>)</span> <span>{</span>
        <span>// Code in here has access to a non-'static &amp;String</span>
        <span>// but assumes that it's a &amp;'static String</span>
        <span>let</span> wrong<span>:</span> <span>&amp;</span><span>'</span><span>static</span> <span>String</span> = <span>self</span><span>.</span><span>0</span><span>.</span><span>unwrap</span><span>(</span><span>)</span><span>;</span>
        thread<span>::</span><span>spawn</span><span>(</span><span>move</span> || <span>{</span>
