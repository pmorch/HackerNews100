        q<span>.</span><span>0</span> = <span>Some</span><span>(</span><span>&amp;</span>l<span>)</span><span>;</span>  <span>// q.0 is supposed to be a &amp;'static String, but we're assigning it a non-'static &amp;String</span>
    <span>}</span>
    thread<span>::</span><span>sleep</span><span>(</span><span>Duration</span><span>::</span><span>from_secs</span><span>(</span><span>2</span><span>)</span><span>)</span><span>;</span>
<span>}</span></pre></div></div><div role="toolbar" aria-label="Reactions"><p><span id="_R_4balnr1st685H2_">Reacted by <!-- -->Filip Dobrosavljević</span></p></div></div></div></li><li data-wrapper-timeline-id="IC_kwDOAAsO6M8AAAABbiuWwg"><div data-testid="timeline-row-border-IC_kwDOAAsO6M8AAAABbiuWwg" data-timeline-event-id="IC_kwDOAAsO6M8AAAABbiuWwg" data-highlighted-event="false"><div id="issuecomment-6143317698" data-testid="comment-header"><h3>maxdexh<!-- --> <!-- -->commented<!-- --> <relative-time data-component="RelativeTime">on<!-- --> <!-- -->Oct 13, 2026<!-- --> </relative-time></h3><p><a data-component="Link" href="https://github.com/maxdexh" aria-label="@maxdexh's profile"><img data-component="Avatar" alt="@maxdexh" width="24" height="24" src="https://avatars.githubusercontent.com/u/211709136?u=a1050f7c5ead9104c24216794532b993b0e17c09&amp;v=4&amp;size=48" data-testid="github-avatar"></a></p></div><div><div data-testid="markdown-body" data-team-hovercards-enabled="true" data-turbolinks="false"><p dir="auto">I think unification just generally doesn't check lifetime bounds of the type. Example with regular unification, without field assignment:</p>
<div dir="auto" data-snippet-clipboard-copy-content="struct Q<T: Copy, F: FnMut(T)>(T, F);

impl<T: Copy, F: FnMut(T)> Drop for Q<T, F> {
    fn drop(&amp;mut self) {
        self.1(self.0)
    }
}

type T = Vec<Vec<i32>>;

fn main() {
    let long = Box::leak(Box::new(T::new())) as &amp;'static T;
    {
        let local: T = vec![vec![1]];

        // item type is Q<&amp;'local T, fn(&amp;'static T)>, which is not WF
        let mut unified = [
            Q(
                long,
                (|s: &amp;'static T| {
                    std::thread::spawn(move || {
                        println!(&quot;{s:?}&quot;);
                    });
                }) as fn(&amp;'static T),
            ),
            Q(&amp;local, (|_: &amp;T| {}) as fn(&amp;T)),
        ];

        let [l, r] = &amp;mut unified;
        std::mem::swap(&amp;mut l.0, &amp;mut r.0);
    }

    std::thread::sleep_ms(1000);
}"><pre><span>struct</span> <span>Q</span><span>&lt;</span><span>T</span><span>:</span> <span>Copy</span><span>,</span> <span>F</span><span>:</span> <span>FnMut</span><span>(</span><span>T</span><span>)</span><span>&gt;</span><span>(</span><span>T</span><span>,</span> <span>F</span><span>)</span><span>;</span>

<span>impl</span><span>&lt;</span><span>T</span><span>:</span> <span>Copy</span><span>,</span> <span>F</span><span>:</span> <span>FnMut</span><span>(</span><span>T</span><span>)</span><span>&gt;</span> <span>Drop</span> <span>for</span> <span>Q</span><span>&lt;</span><span>T</span><span>,</span> <span>F</span><span>&gt;</span> <span>{</span>
    <span>fn</span> <span>drop</span><span>(</span><span>&amp;</span><span>mut</span> <span>self</span><span>)</span> <span>{</span>
        <span>self</span><span>.</span><span>1</span><span>(</span><span>self</span><span>.</span><span>0</span><span>)</span>
    <span>}</span>
<span>}</span>

<span>type</span> <span>T</span> = <span>Vec</span><span>&lt;</span><span>Vec</span><span>&lt;</span><span>i32</span><span>&gt;</span><span>&gt;</span><span>;</span>

<span>fn</span> <span>main</span><span>(</span><span>)</span> <span>{</span>
    <span>let</span> long = <span>Box</span><span>::</span><span>leak</span><span>(</span><span>Box</span><span>::</span><span>new</span><span>(</span><span>T</span><span>::</span><span>new</span><span>(</span><span>)</span><span>)</span><span>)</span> <span>as</span> <span>&amp;</span><span>'</span><span>static</span> <span>T</span><span>;</span>
    <span>{</span>
        <span>let</span> local<span>:</span> <span>T</span> = <span>vec</span><span>!</span><span>[</span>vec!<span>[</span><span>1</span><span>]</span><span>]</span><span>;</span>

        <span>// item type is Q&lt;&amp;'local T, fn(&amp;'static T)&gt;, which is not WF</span>
        <span>let</span> <span>mut</span> unified = <span>[</span>
            <span>Q</span><span>(</span>
                long<span>,</span>
                <span>(</span>|<span>s</span><span>:</span> <span>&amp;</span><span>'</span><span>static</span> <span>T</span>| <span>{</span>
                    std<span>::</span>thread<span>::</span><span>spawn</span><span>(</span><span>move</span> || <span>{</span>
                        <span>println</span><span>!</span><span>(</span><span>"{s:?}"</span><span>)</span><span>;</span>
                    <span>}</span><span>)</span><span>;</span>
                <span>}</span><span>)</span> <span>as</span> <span>fn</span><span>(</span><span>&amp;</span><span>'</span><span>static</span> <span>T</span><span>)</span><span>,</span>
            <span>)</span><span>,</span>
            <span>Q</span><span>(</span><span>&amp;</span>local<span>,</span> <span>(</span>|_<span>:</span> <span>&amp;</span><span>T</span>| <span>{</span><span>}</span><span>)</span> <span>as</span> <span>fn</span><span>(</span><span>&amp;</span><span>T</span><span>)</span><span>)</span><span>,</span>
        <span>]</span><span>;</span>

        <span>let</span> <span>[</span>l<span>,</span> r<span>]</span> = <span>&amp;</span><span>mut</span> unified<span>;</span>
        std<span>::</span>mem<span>::</span><span>swap</span><span>(</span><span>&amp;</span><span>mut</span> l<span>.</span><span>0</span><span>,</span> <span>&amp;</span><span>mut</span> r<span>.</span><span>0</span><span>)</span><span>;</span>
    <span>}</span>

    std<span>::</span>thread<span>::</span><span>sleep_ms</span><span>(</span><span>1000</span><span>)</span><span>;</span>
<span>}</span></pre></div></div><div role="toolbar" aria-label="Reactions"><p><span id="_R_4balvr1st685H2_">Reacted by <!-- -->9291Sam, Bee4Queer, Maple and Thefool</span></p></div></div></div></li></ol></div><!--/$--></div></div>]]></description>
