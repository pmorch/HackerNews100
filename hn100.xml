ta-prc-v-col="3">48</td><td data-prc-v-col="4">46</td><td data-prc-v-col="5">+11</td></tr><tr><td data-prc-v-col="0">Israel</td><td data-prc-v-col="1">69</td><td data-prc-v-col="2">69</td><td data-prc-v-col="3">70</td><td data-prc-v-col="4">59</td><td data-prc-v-col="5">+10</td></tr><tr><td data-prc-v-col="0">Malaysia</td><td data-prc-v-col="1">77</td><td data-prc-v-col="2">77</td><td data-prc-v-col="3">66</td><td data-prc-v-col="4">68</td><td data-prc-v-col="5">+9</td></tr><tr><td data-prc-v-col="0">Argentina</td><td data-prc-v-col="1">60</td><td data-prc-v-col="2">60</td><td data-prc-v-col="3">57</td><td data-prc-v-col="4">51</td><td data-prc-v-col="5">+9</td></tr></tbody></table></figure>
