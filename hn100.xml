<span><span>    P1  </span><span>=</span><span> parity(a </span><span>&amp;</span><span> (</span><span>0x</span><span>76A990400</span><span> ^</span><span> b35))        </span><span># wide form, only needed for the L40S read-out</span></span>
<span><span>    P2  </span><span>=</span><span> parity(a </span><span>&amp;</span><span> 0x</span><span>2CCF7B000</span><span>)                </span><span># controller parity 2</span></span>
<span><span>    A   </span><span>=</span><span> ((a </span><span>&gt;&gt;</span><span> 15</span><span>) </span><span>+</span><span> 2</span><span>*</span><span>parity(a </span><span>&amp;</span><span> 0x</span><span>3C9041000</span><span>) </span><span>+</span><span> parity(a </span><span>&amp;</span><span> (</span><span>0x</span><span>2882B0800</span><span> ^</span><span> b35)) </span><span>+</span><span> 2</span><span>) </span><span>%</span><span> 3</span><span>  # mod-3 digit: (a&gt;&gt;15) + 2 corrections</span></span>
