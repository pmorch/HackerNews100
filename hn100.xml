}

fn main() {
    let mut me_out = &quot;rarw&quot;;
    {
        let l = String::from(&quot;some cool string&quot;);
        let mut q = MyType(&amp;mut me_out, &quot;&quot;);
        q.1 = &amp;l;
        
    }
