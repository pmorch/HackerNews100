    q.0 = Some(&amp;l);
}"><pre><span>struct</span> <span>Q</span><span>&lt;</span><span>T</span><span>:</span> <span>'</span><span>static</span><span>&gt;</span><span>(</span><span>Option</span><span>&lt;</span><span>T</span><span>&gt;</span><span>)</span><span>;</span>

<span>impl</span><span>&lt;</span><span>T</span><span>:</span> <span>'</span><span>static</span><span>&gt;</span> <span>Drop</span> <span>for</span> <span>Q</span><span>&lt;</span><span>T</span><span>&gt;</span> <span>{</span>
    <span>fn</span> <span>drop</span><span>(</span><span>&amp;</span><span>mut</span> <span>self</span><span>)</span> <span>{</span>
        <span>// Code in here has access to a non-'static &amp;String</span>
        <span>// but assumes that it's a &amp;'static String</span>
    <span>}</span>
<span>}</span>

<span>fn</span> <span>main</span><span>(</span><span>)</span> <span>{</span>
    <span>let</span> l = <span>String</span><span>::</span><span>new</span><span>(</span><span>)</span><span>;</span>
    <span>let</span> <span>mut</span> q = <span>Q</span><span>(</span><span>None</span><span>)</span><span>;</span>
    q<span>.</span><span>0</span> = <span>Some</span><span>(</span><span>&amp;</span>l<span>)</span><span>;</span>
<span>}</span></pre></div></div><div role="toolbar" aria-label="Reactions"><p><span id="_R_4bahnr1st685H2_">Reacted by <!-- -->Daniel Vogelbacher, Serhiy, BioTomateDE, Timur Tugushev, palapapa, Ori Yadid, SeniorMars, dzmitry-lahoda, Til and Marco Quinten</span></p></div></div></div></li><li data-timeline-event-id="LE_lADOAAsO6M8AAAABW1X2hM8AAAAHtfxnnQ" data-highlighted-event="false" data-testid="timeline-row-border-LE_lADOAAsO6M8AAAABW1X2hM8AAAAHtfxnnQ" data-wrapper-timeline-id="LE_lADOAAsO6M8AAAABW1X2hM8AAAAHtfxnnQ"></li><li data-timeline-event-id="UNLE_lADOAAsO6M8AAAABW1X2hM8AAAAHtf0JvA" data-highlighted-event="false" data-testid="timeline-row-border-UNLE_lADOAAsO6M8AAAABW1X2hM8AAAAHtf0JvA" data-wrapper-timeline-id="UNLE_lADOAAsO6M8AAAABW1X2hM8AAAAHtf0JvA"></li><li data-wrapper-timeline-id="IC_kwDOAAsO6M8AAAABbhrS0g"><div id="issuecomment-6142218962" data-testid="timeline-row-border-IC_kwDOAAsO6M8AAAABbhrS0g" data-timeline-event-id="IC_kwDOAAsO6M8AAAABbhrS0g" data-highlighted-event="false"><h3>rustbot<!-- --> <!-- -->commented<!-- --> <relative-time data-component="RelativeTime">on<!-- --> <!-- -->Oct 13, 2026<!-- --> </relative-time></h3><p><a data-component="Link" href="https://github.com/rustbot" aria-label="@rustbot's profile"><img data-component="Avatar" alt="@rustbot" width="24" height="24" src="https://avatars.githubusercontent.com/u/47979223?u=8e3da52dfa4b8cfeb822acd82600ee339d4637bd&amp;v=4&amp;size=48" data-testid="github-avatar"></a></p></div></li><li data-timeline-event-id="LE_lADOAAsO6M8AAAABW1X2hM8AAAAHtf0Tkw" data-highlighted-event="false" data-testid="timeline-row-border-LE_lADOAAsO6M8AAAABW1X2hM8AAAAHtf0Tkw" data-wrapper-timeline-id="LE_lADOAAsO6M8AAAABW1X2hM8AAAAHtf0Tkw"></li><li data-wrapper-timeline-id="IC_kwDOAAsO6M8AAAABbhtXbw"><div data-testid="timeline-row-border-IC_kwDOAAsO6M8AAAABbhtXbw" data-timeline-event-id="IC_kwDOAAsO6M8AAAABbhtXbw" data-highlighted-event="false"><div id="issuecomment-6142252911" data-testid="comment-header"><h3>theemathas<!-- --> <!-- -->commented<!-- --> <relative-time data-component="RelativeTime">on<!-- --> <!-- -->Oct 13, 2026<!-- --> </relative-time></h3><p><a data-component="Link" href="https://github.com/theemathas" aria-label="@theemathas's profile"><img data-component="Avatar" alt="@theemathas" width="24" height="24" src="https://avatars.githubusercontent.com/u/6120103?v=4&amp;size=48" data-testid="github-avatar"></a></p></div><div><div data-testid="markdown-body" data-team-hovercards-enabled="true" data-turbolinks="false"><p dir="auto">My version of the code has been compiling ever since 1.18.0 (2017)</p>
<p dir="auto">How on earth was this not found before this???</p></div><div role="toolbar" aria-label="Reactions"><p><span id="_R_4baivr1st685H2_">Reacted by <!-- -->Max, Alisa Sireneva, Leon, maxbry-uh, Luke, slaiyer, Screeching Bagel, Slanterns, maliciousblahaj, Timur Tugushev and 7 more</span></p></div></div></div></li><li data-wrapper-timeline-id="IC_kwDOAAsO6M8AAAABbhxoAg"><div id="issuecomment-6142322690" data-testid="timeline-row-border-IC_kwDOAAsO6M8AAAABbhxoAg" data-timeline-event-id="IC_kwDOAAsO6M8AAAABbhxoAg" data-highlighted-event="false"><h3>theemathas<!-- --> <!-- -->commented<!-- --> <relative-time data-component="RelativeTime">on<!-- --> <!-- -->Oct 13, 2026<!-- --> </relative-time></h3><p><a data-component="Link" href="https://github.com/theemathas" aria-label="@theemathas's profile"><img data-component="Avatar" alt="@theemathas" width="24" height="24" src="https://avatars.githubusercontent.com/u/6120103?v=4&amp;size=48" data-testid="github-avatar"></a></p></div></li><li data-wrapper-timeline-id="IC_kwDOAAsO6M8AAAABbh28Bg"><div data-testid="timeline-row-border-IC_kwDOAAsO6M8AAAABbh28Bg" data-timeline-event-id="IC_kwDOAAsO6M8AAAABbh28Bg" data-highlighted-event="false"><div id="issuecomment-6142409734" data-testid="comment-header"><h3>lcnr<!-- --> <!-- -->commented<!-- --> <relative-time data-component="RelativeTime">on<!-- --> <!-- -->Oct 13, 2026<!-- --> </relative-time></h3><p><a data-component="Link" href="https://github.com/lcnr" aria-label="@lcnr's profile"><img data-component="Avatar" alt="@lcnr" width="24" height="24" src="https://avatars.githubusercontent.com/u/29864074?u=133f9259e09c1bc34f6f4dd2451554472abddfff&amp;v=4&amp;size=48" data-testid="github-avatar"></a></p></div><div><div data-testid="markdown-body" data-team-hovercards-enabled="true" data-turbolinks="false"><p dir="auto">without relying on a <code>static</code></p>
<div dir="auto" data-snippet-clipboard-copy-content="struct MyType<'a, 'b: 'a, 'c>(&amp;'c mut &amp;'a str, &amp;'b str);

impl<'a, 'b: 'a, 'c> Drop for MyType<'a, 'b, 'c> {
